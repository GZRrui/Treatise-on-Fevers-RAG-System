{
  "openapi": "3.1.0",
  "info": {
    "title": "《伤寒论》RAG 智能问答系统 API",
    "description": "《伤寒论》智能问答系统后端 API。",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "健康检查"
        ],
        "summary": "Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "健康检查"
        ],
        "summary": "Readiness Check",
        "operationId": "readiness_check_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/qa": {
      "post": {
        "tags": [
          "问答"
        ],
        "summary": "Ask Question",
        "operationId": "ask_question_api_v1_qa_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QARequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QAResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/qa/stream": {
      "post": {
        "tags": [
          "问答"
        ],
        "summary": "Ask Question Stream",
        "operationId": "ask_question_stream_api_v1_qa_stream_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QARequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/search": {
      "post": {
        "tags": [
          "检索"
        ],
        "summary": "Search Articles",
        "operationId": "search_articles_api_v1_search_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/index/build": {
      "post": {
        "tags": [
          "索引管理"
        ],
        "summary": "Build Index",
        "operationId": "build_index_api_v1_index_build_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BuildIndexRequest",
                "default": {
                  "force": false
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndexBuildResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/index/status": {
      "get": {
        "tags": [
          "索引管理"
        ],
        "summary": "Get Index Status",
        "operationId": "get_index_status_api_v1_index_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndexStatusResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ArticleSource": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "standard_id": {
            "type": "integer",
            "title": "Standard Id"
          },
          "chapter": {
            "type": "string",
            "title": "Chapter"
          },
          "section": {
            "type": "string",
            "title": "Section"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "formulas": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Formulas"
          }
        },
        "type": "object",
        "required": [
          "id",
          "standard_id",
          "chapter",
          "section",
          "category",
          "text",
          "score"
        ],
        "title": "ArticleSource"
      },
      "BuildIndexRequest": {
        "properties": {
          "force": {
            "type": "boolean",
            "title": "Force",
            "description": "是否强制重建",
            "default": false
          }
        },
        "type": "object",
        "title": "BuildIndexRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IndexBuildData": {
        "properties": {
          "exists": {
            "type": "boolean",
            "title": "Exists"
          },
          "vector_count": {
            "type": "integer",
            "title": "Vector Count",
            "default": 0
          },
          "storage_path": {
            "type": "string",
            "title": "Storage Path",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "exists"
        ],
        "title": "IndexBuildData"
      },
      "IndexBuildResponse": {
        "properties": {
          "code": {
            "type": "integer",
            "title": "Code",
            "default": 200
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "data": {
            "$ref": "#/components/schemas/IndexBuildData"
          }
        },
        "type": "object",
        "required": [
          "message",
          "data"
        ],
        "title": "IndexBuildResponse"
      },
      "IndexStatusResponse": {
        "properties": {
          "exists": {
            "type": "boolean",
            "title": "Exists"
          },
          "vector_count": {
            "type": "integer",
            "title": "Vector Count",
            "default": 0
          },
          "storage_path": {
            "type": "string",
            "title": "Storage Path",
            "default": ""
          },
          "embedding_model": {
            "type": "string",
            "title": "Embedding Model",
            "default": ""
          },
          "embedding_dim": {
            "type": "integer",
            "title": "Embedding Dim",
            "default": 0
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "exists"
        ],
        "title": "IndexStatusResponse"
      },
      "QAData": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "query": {
            "type": "string",
            "title": "Query"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/ArticleSource"
            },
            "type": "array",
            "title": "Sources"
          },
          "source_count": {
            "type": "integer",
            "title": "Source Count",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "answer",
          "query"
        ],
        "title": "QAData"
      },
      "QARequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Query",
            "description": "用户问题"
          },
          "top_k": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Top K",
            "description": "检索数量",
            "default": 5
          },
          "stream": {
            "type": "boolean",
            "title": "Stream",
            "description": "是否流式输出",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "QARequest"
      },
      "QAResponse": {
        "properties": {
          "code": {
            "type": "integer",
            "title": "Code",
            "default": 200
          },
          "message": {
            "type": "string",
            "title": "Message",
            "default": "success"
          },
          "data": {
            "$ref": "#/components/schemas/QAData"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "QAResponse"
      },
      "SearchData": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/ArticleSource"
            },
            "type": "array",
            "title": "Results"
          }
        },
        "type": "object",
        "required": [
          "query",
          "total",
          "results"
        ],
        "title": "SearchData"
      },
      "SearchRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Query",
            "description": "检索词"
          },
          "top_k": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Top K",
            "description": "返回数量",
            "default": 5
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category",
            "description": "按病证分类筛选"
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "SearchRequest"
      },
      "SearchResponse": {
        "properties": {
          "code": {
            "type": "integer",
            "title": "Code",
            "default": 200
          },
          "message": {
            "type": "string",
            "title": "Message",
            "default": "success"
          },
          "data": {
            "$ref": "#/components/schemas/SearchData"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "SearchResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}

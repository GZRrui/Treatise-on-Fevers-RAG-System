# Development defaults. Copy to .env and opt in to online providers explicitly.
APP_ENV=development

# ============ 阿里云 DashScope 配置 ============
DASHSCOPE_API_KEY=

# ============ 数据库配置 ============
DATABASE_URL=sqlite+aiosqlite:///./storage/rag_system.db

# ============ 数据与向量存储配置 ============
DATA_DIR=./data
STORAGE_DIR=./storage
VECTOR_STORE_PATH=./storage/vector_store.json

# ============ RAG 配置 ============
# Embedding 模型
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1536
RAG_OFFLINE_MODE=true

# LLM 模型
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# 检索配置
TOP_K=5
SIMILARITY_THRESHOLD=0.7

# ============ FastAPI 配置 ============
HOST=0.0.0.0
PORT=8000
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============ JWT 认证（预留）============
JWT_SECRET=dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============ 限流配置（预留）============
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
